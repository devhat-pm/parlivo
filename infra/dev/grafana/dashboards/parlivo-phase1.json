{
  "uid": "parlivo-phase1",
  "title": "Parlivo phase 1: clause to echo",
  "tags": ["parlivo"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Clause to echo p50 (5 min)",
      "description": "Last voiced frame of a clause to the first echo frame published. Phase 1 stand-in for glass-to-ear (ARCHITECTURE.md section 4).",
      "datasource": {
        "type": "prometheus",
        "uid": "parlivo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "parlivo-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(parlivo_clause_to_echo_milliseconds_bucket[5m])))"
        }
      ]
    },
    {
