{
  "name": "parlivo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "py": "bash scripts/py.sh",
    "dev:infra": "docker compose -f infra/dev/docker-compose.yml up -d --wait",
    "dev:infra:down": "docker compose -f infra/dev/docker-compose.yml down",
    "dev:infra:reset": "docker compose -f infra/dev/docker-compose.yml down -v",
    "dev:infra:logs": "docker compose -f infra/dev/docker-compose.yml logs -f",
    "docs:diagrams": "node scripts/render-diagrams.mjs",
    "gpu:login": "node infra/gpu-dev/gpu.mjs login",
    "gpu:up": "node infra/gpu-dev/gpu.mjs up",
    "gpu:bootstrap": "node infra/gpu-dev/gpu.mjs bootstrap",
    "gpu:ssh": "node infra/gpu-dev/gpu.mjs ssh",
    "gpu:status": "node infra/gpu-dev/gpu.mjs status",
    "gpu:stop": "node infra/gpu-dev/gpu.mjs stop",
    "gpu:down": "node infra/gpu-dev/gpu.mjs down"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "mermaid": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
