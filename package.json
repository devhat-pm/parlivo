{
  "name": "parlivo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "py": "bash scripts/py.sh",
    "dev:infra": "docker compose -f infra/dev/docker-compose.yml up -d --wait",
    "dev:infra:down": "docker compose -f infra/dev/docker-compose.yml down",
    "dev:infra:reset": "docker compose -f infra/dev/docker-compose.yml down -v",
    "dev:infra:logs": "docker compose -f infra/dev/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
