{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parlivo",
  "version": "0.0.0",
  "identifier": "com.parlivo.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3100",
    "beforeBuildCommand": "pnpm --filter @parlivo/web build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Parlivo",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
